{
  "name": "cn-owlpin-report-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "云鸮小助报告 MCP 入口（EdgeOne Makers 边缘函数），创建报告转发给 payload",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "deploy": "edgeone makers deploy -n cn-owlpin-report-mcp",
    "pack:expert": "rm -f online-report-expert.zip && cd expert && zip -qr ../online-report-expert.zip . -x '*.DS_Store'"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "typescript": "5.9.3",
    "vitest": "^4.0.18"
  }
}
